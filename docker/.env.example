# List of env variables that are used in docker compose

# MySQL root password for the main `db` service. Set once here and it flows to:
#   - the `db` container (MYSQL_ROOT_PASSWORD + healthcheck)
#   - NODE_DATABASE_URL embedded in nodejs-api / nodejs-worker
# Local-dev only — override in docker/.env if you want something stronger.
MYSQL_ROOT_PASSWORD=password
# Separate password for the optional GSRS MariaDB (only used when
# PFDA_SHOULD_RUN_GSRS=1).
GSRS_DB_ROOT_PASSWORD=password

# Speedup util - skips ruby deps installation - ASSUMES PRESENCE IN CACHE
SKIP_RUBY_DEPS_SETUP=0
# Speedup util - skips nodejs api and worker deps installation - ASSUMES PRESENCE IN CACHE
SKIP_NODEJS_DEPS_SETUP=0
# Speedup util - skips frontend deps installation
SKIP_FRONTEND_DEPS_SETUP=0
# Speedup util - skips running active record migration
SKIP_DB_SETUP=0

# Entrypoint configuration - Frequency of database polling - used by the dist (non-dev) Node entrypoint
NODEJS_DB_POLLING_INTERVAL=5

# When 0, Nest dev runs without --watch (faster container stops). Default 1 (watch enabled).
NODE_DEV_WATCH=1

# URL - nodejs API url
NODE_API_URL=https://host.docker.internal:3001
# URL - ruby API url
RUBY_API_URL=https://host.docker.internal:5012
DOCS_URL=http://host.docker.internal:4040
# for native node
# NODE_API_URL=https://host.docker.internal:3001
