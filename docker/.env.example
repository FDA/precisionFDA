# List of env variables that are used in docker compose

# MySQL root password for the main `db` service. Set once here and it flows to:
#   - the `db` container (MYSQL_ROOT_PASSWORD + healthcheck)
#   - NODE_DATABASE_URL embedded in nodejs-api / nodejs-worker
# Local-dev only — override in docker/.env if you want something stronger.
MYSQL_ROOT_PASSWORD=password
# Separate password for the optional GSRS MariaDB (only used when
# PFDA_SHOULD_RUN_GSRS=1).
GSRS_DB_ROOT_PASSWORD=password

# Ruby/Node/frontend deps are installed automatically only when the lockfile changes
# (entrypoints fingerprint Gemfile.lock / pnpm-lock.yaml against a marker in the deps cache
# volume), so there are no SKIP_*_DEPS_SETUP flags to manage. To force a clean reinstall, wipe
# the relevant cache volume, e.g. `docker volume rm <project>_bundler-deps-cache-ruby`.

# Speedup util - skips running active record migration
SKIP_DB_SETUP=0

# Entrypoint configuration - Frequency of database polling - used by the dist (non-dev) Node entrypoint
NODEJS_DB_POLLING_INTERVAL=5

# When 0, Nest dev runs without --watch (faster container stops). Default 1 (watch enabled).
NODE_DEV_WATCH=0

# Upstream URLs for the nginx container (Docker Compose service names, not host ports).
# Do NOT use host.docker.internal here — host port 3001 is often occupied by a local
# Node/Vite process speaking plain HTTP, which causes SSL handshake failures (502).
NODE_API_URL=https://nodejs-api:3001
RUBY_API_URL=https://web:3000
DOCS_URL=http://docs:4040

RECAPTCHA_SITE_KEY=NEED_A_KEY_4_TEST

# VITE_OUT_DIR=dist
# Only when running Node/Rails natively on the host (outside Docker):
# NODE_API_URL=https://host.docker.internal:3001
# RUBY_API_URL=https://host.docker.internal:3005
