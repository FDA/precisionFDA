{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "root": false,
  "extends": "//",
  "files": {
    "includes": ["app/**", "components/**", "lib/**", "*.ts", "*.mjs", "biome.json", "!next-env.d.ts"]
  },
  "linter": {
    "rules": {
      "correctness": {
        "noUnusedVariables": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noImportCycles": "warn"
      }
    }
  }
}
