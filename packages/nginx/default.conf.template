server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;

  server_name localhost;
  ssl_certificate /keys/cert.pem;
  ssl_certificate_key /keys/key.pem;

  root /usr/share/nginx/html;
  index index.html;

  location /docs {
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Ssl on;
    proxy_set_header Host $http_host;
    proxy_redirect off;
    proxy_pass ${DOCS_URL};
    proxy_cookie_path / "/; HTTPOnly; Secure";
  }

  location /ws {
    proxy_pass ${NODE_API_URL}/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
  }

  # GSRS static assets served directly via gsrs-nginx (no auth needed, faster).
  # All other /ginas/* requests are proxied to Rails (see location /ginas/ below)
  # which injects AUTHENTICATION_USERNAME/EMAIL headers and reverse-proxies to GSRS.
  location ~ ^/ginas/.*((\.(js|css|png|jpg|jpeg|gif))|(manifest\.json))$ {
    resolver 127.0.0.11 valid=10s;
    set $gsrs_upstream http://gsrs-nginx:80;
    proxy_pass $gsrs_upstream;
  }

  # Dynamic GSRS endpoints handled by Rails (whoami, substances, csrf-token,
  # reverse-proxy, /substances/api/... redirect, and the catch-all /ginas/*path).
  # Without these, requests fall through to `location /` and receive the React
  # SPA's index.html, which breaks the GSRS (e.g. it ends up putting
  # HTML into XHR headers via setRequestHeader).
  location /ginas/ {
    proxy_pass ${RUBY_API_URL};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
    proxy_redirect off;
  }

  location = /csrf-token {
    proxy_pass ${RUBY_API_URL};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
    proxy_redirect off;
  }

  location /substances/ {
    proxy_pass ${RUBY_API_URL};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
    proxy_redirect off;
  }

  location ~ ^/api/files/([^/]+)/download$ {
    set $uid $1;
    if ($http_authorization ~* "^Key ") {
      return 301 $scheme://$http_host/api/v2/files/$uid/download/legacy$is_args$args;
    }
    return 301 $scheme://$http_host/api/v2/files/$uid/download$is_args$args;
  }

  location ~ ^/api/files/([^/]+)/describe$ {
    return 301 $scheme://$http_host/api/v2/cli/$1/describe;
  }

  location ~ ^/api/files/selected$ {
    return 301 $scheme://$http_host/api/v2/files/selected$is_args$args;
  }

  location ~ ^/api/files/([^/]+)/([^/]+)$ {
    return 301 $scheme://$http_host/api/v2/files/$1/$2$is_args$args;
  }

  location = /api/create_file {
    proxy_pass ${NODE_API_URL}/files;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
    proxy_redirect off;
  }

  # Redirect deprecated singular /job/ path to plural /jobs/
  location ~ ^/api/v2/cli/job/([^/]+)/scope$ {
    return 301 /api/v2/cli/jobs/$1/scope;
  }

  location /api/v2/ {
    proxy_pass ${NODE_API_URL}/;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
  }

  location /api/docs/ {
    proxy_pass ${NODE_API_URL}/api/docs/;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
  }

  location ~ ^/(notes|comparisons)/[^/]+/track(/|$) {
    try_files $uri $uri/ /index.html;
  }

  location ~ ^/(logout|return_from_login|login|pdfs|notes|comparisons|comparators|licenses|users|profile|guidelines|set_tags|presskit)(/|$) {
    proxy_pass ${RUBY_API_URL};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
    proxy_redirect off;
  }

  location ~ ^/(apps|workflows|jobs|files|assets|comparisons|notes)/.+/comments(/.*)?$ {
    proxy_pass ${RUBY_API_URL};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
  }

  location = /experts/new {
    proxy_pass ${RUBY_API_URL};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
  }

  location = /experts/create {
    proxy_pass ${RUBY_API_URL};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
  }

  location ~ ^/experts/.+/(edit|qa|ask_question)/?$ {
    proxy_pass ${RUBY_API_URL};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
  }

  location ~ ^/challenges/.+/(editor/resources|challenge_resources/new)/?$ {
    proxy_pass ${RUBY_API_URL};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
  }

  location ~ ^/challenges/[^/]+/submissions/create/?$ {
    proxy_pass ${RUBY_API_URL};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
  }

  location ~ ^/challenges/(truth(/results?(-explore)?)?|consistency(/results)?|app-a-thon-in-a-box)(/.*)?$ {
    proxy_pass ${RUBY_API_URL};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
  }

  location ~ ^/challenges/[^/]+/submissions/(new|[^/]+/edit)/?$ {
    proxy_pass ${RUBY_API_URL};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
  }

  location = /workflows/new {
    proxy_pass ${RUBY_API_URL};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
  }

  location ~ ^/workflows/.+/(edit|fork)/?$ {
    proxy_pass ${RUBY_API_URL};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
  }

  location ~ ^/workflows/.+/(batch_workflow|run_batch|terminate_batch|output_folders_list|output_folder_create|output_folder_update)/?$ {
    proxy_pass ${RUBY_API_URL};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
  }

  location = /workflows/convert_file_with_strings {
    proxy_pass ${RUBY_API_URL};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
  }

  location ~ ^/apps/.+/(export|cwl_export|wdl_export)/?$ {
    proxy_pass ${RUBY_API_URL};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
  }

  location ~ ^/workflows/.+/(cwl_export|wdl_export)/?$ {
    proxy_pass ${RUBY_API_URL};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
  }

  location ~ ^/admin/(comparator_settings|org_action_requests|organizations)(/|$) {
    proxy_pass ${RUBY_API_URL};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
    proxy_redirect off;
  }

  # Client build ships /assets/participants/* etc.; Rails asset pipeline serves the rest.
  location /assets/ {
    try_files $uri @rails_assets;
  }

  location @rails_assets {
    proxy_pass ${RUBY_API_URL};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
  }

  location /api/ {
    proxy_pass ${RUBY_API_URL};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
    proxy_redirect off;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
