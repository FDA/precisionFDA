<% content_for :title do %>Licenses<% end %>

<div class="pfda-toolbar" data-testid="licenses-index-toolbar">
  <div class="btn-group">
    <%= link_to licenses_path(), method: :post, class: 'btn btn-primary', data: {disable_with: "Creating...", testid: "license-create-button"} do %>
      <span class="fa fa-plus fa-fw"></span> Create a License
    <% end %>
  </div>
</div>

<div data-testid="licenses-grid">
  <%= render "licenses/grid", licenses_grid: @owned_licenses_grid %>
</div>
