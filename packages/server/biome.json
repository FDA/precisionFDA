{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "root": false,
  "extends": "//",
  "files": {
    "includes": ["apps/**", "libs/**", "biome.json"],
    "maxSize": 4194304
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "rules": {
      "style": {
        "useImportType": "off"
      },
      "nursery": {
        "useExplicitType": "error"
      }
    }
  }
}
